{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://theheritageshort.local/schema/storyboard.schema.json",
    "title": "BONO Heritage Short Storyboard",
    "description": "Validation contract for the BONO heritage film production pipeline.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "project",
        "production",
        "audio",
        "shots"
    ],
    "properties": {
        "project": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "title",
                "description",
                "target_duration_sec",
                "aspect_ratios"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                },
                "target_duration_sec": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 90
                },
                "aspect_ratios": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "9:16",
                            "16:9"
                        ]
                    },
                    "minItems": 2,
                    "uniqueItems": true
                }
            }
        },
        "production": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "image_model",
                "video_model",
                "max_clip_duration_sec"
            ],
            "properties": {
                "image_model": {
                    "type": "string",
                    "minLength": 1
                },
                "video_model": {
                    "type": "string",
                    "minLength": 1
                },
                "max_clip_duration_sec": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 3
                }
            }
        },
        "audio": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "narration",
                "music"
            ],
            "properties": {
                "narration": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "enabled",
                        "language",
                        "style",
                        "voice_description"
                    ],
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "language": {
                            "type": "string",
                            "const": "am"
                        },
                        "style": {
                            "type": "string",
                            "const": "reflective_documentary"
                        },
                        "voice_description": {
                            "type": "string"
                        }
                    }
                },
                "music": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "enabled",
                        "prompt"
                    ],
                    "properties": {
                        "enabled": {
                            "type": "boolean"
                        },
                        "prompt": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "shots": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                    "id",
                    "duration_sec",
                    "visual_prompt",
                    "motion_prompt",
                    "narration_am",
                    "subtitle_en",
                    "reason",
                    "generation"
                ],
                "properties": {
                    "id": {
                        "type": "string",
                        "pattern": "^shot_[0-9]{2,}$"
                    },
                    "duration_sec": {
                        "type": "number",
                        "exclusiveMinimum": 0
                    },
                    "visual_prompt": {
                        "type": "string",
                        "minLength": 1
                    },
                    "motion_prompt": {
                        "type": "string",
                        "minLength": 1
                    },
                    "narration_am": {
                        "type": "string"
                    },
                    "subtitle_en": {
                        "type": "string"
                    },
                    "reason": {
                        "type": "string",
                        "minLength": 1
                    },
                    "generation": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "image",
                            "video"
                        ],
                        "properties": {
                            "image": {
                                "type": "boolean"
                            },
                            "video": {
                                "type": "boolean"
                            }
                        }
                    }
                }
            }
        }
    }
}