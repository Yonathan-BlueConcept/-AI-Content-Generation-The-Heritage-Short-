{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "title",
        "language",
        "shots"
    ],
    "properties": {
        "title": {
            "type": "string",
            "minLength": 1
        },
        "language": {
            "type": "string",
            "minLength": 2
        },
        "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "duration_sec",
                    "narration",
                    "visual_prompt",
                    "reason"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "duration_sec": {
                        "type": "number",
                        "minimum": 1
                    },
                    "narration": {
                        "type": "string"
                    },
                    "visual_prompt": {
                        "type": "string"
                    },
                    "reason": {
                        "type": "string"
                    }
                }
            }
        }
    }
}